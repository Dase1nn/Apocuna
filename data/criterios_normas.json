  "patrones_exclusion": [
    {
      "id": "viajes",
      "motivo": "Excluida: autorización o modificación de viaje de funcionarios o servidores públicos",
      "patrones_regex": [
        "\\bautorizan\\s+(?:el\\s+|la\\s+)?viaje\\b",
        "\\bmodifican\\b.{0,120}\\bautoriza(?:n)?\\s+viaje\\b",
        "\\ben\\s+comisi[oó]n\\s+de\\s+servicios\\b",
        "\\ben\\s+misi[oó]n\\s+de\\s+estudios\\b",
        "\\bviaje\\s+de\\s+pr[aá]cticas\\b"
      ]
    },
    {
      "id": "designaciones_nombramientos",
      "motivo": "Excluida: designación o nombramiento de personal o autoridades en cargos específicos",
      "patrones_regex": [
        "^\\s*designan\\b",
        "\\bdesignan\\s+(?:a\\s+|al\\s+|como\\s+|director|jefe|gerente|asesor|miembro|fiscales|representante)",
        "^\\s*nombran\\b",
        "\\bnombran\\s+(?:fiscal|a\\s+)",
        "\\bdan\\s+por\\s+concluida\\s+la\\s+designaci[oó]n\\b",
        "\\bdan\\s+por\\s+concluido\\s+el\\s+nombramiento\\b"
      ]
    },
    {
      "id": "encargos",
      "motivo": "Excluida: encargo de despacho, puesto o funciones",
      "patrones_regex": [
        "^\\s*encargan\\b",
        "\\bencargan\\s+(?:el\\s+despacho|la\\s+oficina|las\\s+funciones|el\\s+puesto)\\b",
        "\\bencargo\\s+de\\s+(?:puesto|funciones|despacho)\\b"
      ]
    },
    {
      "id": "renuncias",
      "motivo": "Excluida: aceptación de renuncia al cargo",
      "patrones_regex": [
        "\\baceptan\\s+(?:la\\s+)?renuncia\\b",
        "\\brenuncia\\s+al\\s+cargo\\b"
      ]
    },
    {
      "id": "extradiciones",
      "motivo": "Excluida: solicitud de extradición o traslado de personas condenadas",
      "patrones_regex": [
        "\\bextradici[oó]n\\s+(?:activa|pasiva)\\b",
        "\\bsolicitud\\s+de\\s+extradici[oó]n\\b",
        "\\btraslado\\s+de\\s+personas\\s+condenadas\\b"
      ]
    },
    {
      "id": "expropiaciones",
      "motivo": "Excluida: aprobación de ejecución de expropiación o valor de tasación de inmueble particular",
      "patrones_regex": [
        "\\bejecuci[oó]n\\s+de\\s+expropiaci[oó]n\\b",
        "\\bvalor\\s+de\\s+(?:la\\s+)?tasaci[oó]n\\b",
        "\\bafectada\\s+de\\s+inmueble\\b"
      ]
    },
    {
      "id": "traslados_oficinas",
      "motivo": "Excluida: traslado físico de oficina o dependencia administrativa",
      "patrones_regex": [
        "\\btraslado\\s+de\\s+(?:la\\s+)?oficina\\b",
        "\\btraslado\\s+de\\s+sede\\b"
      ]
    },
    {
      "id": "edictos_matrimoniales",
      "motivo": "Excluida: dispensa de edicto matrimonial o matrimonio civil comunitario",
      "patrones_regex": [
        "\\bedictos?\\s+matrimonial(?:es)?\\b",
        "\\bmatrimonio\\s+civil\\s+comunitario\\b"
      ]
    },
    {
      "id": "proteccion_provisional_arqueologica",
      "motivo": "Excluida: determinación de protección provisional de sitio o paisaje arqueológico individual",
      "patrones_regex": [
        "\\bprotecci[oó]n\\s+provisional\\s+del\\s+(?:sitio|paisaje|zona|monumento)\\s+arqueol[oó]gic[oa]\\b"
      ]
    },
    {
      "id": "actos_jurisdiccionales_y_particulares",
      "motivo": "Excluida: resolución jurisdiccional/electoral sobre expediente individual o autorización operativa a empresa/administrado particular",
      "patrones_regex": [
        "\\b(?:confirman|revocan|declaran\\s+nula)\\s+(?:extremo\\s+de\\s+)?la\\s+resoluci[oó]n\\s+n\\.?\\s*º?°?",
        "\\bresuelven\\s+recurso\\s+de\\s+apelaci[oó]n\\s+interpuesto\\s+en\\s+contra\\s+de\\s+la\\s+resoluci[oó]n\\b",
        "\\bcaducidad\\s+del\\s+procedimiento\\s+administrativo\\s+sancionador\\b",
        "\\bautorizan\\s+a\\s+la\\s+empresa\\b.{0,120}\\bpara\\s+operar\\s+como\\s+centro\\s+de\\s+inspecci[oó]n\\s+t[eé]cnica\\s+vehicular\\b"
      ]
    }
  ],
